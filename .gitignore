# OS
.DS_Store
._*

# Env / secrets
.env
.env.*
!.env.example
*.p8
*.p12
*.jks
*.key
*.mobileprovision
*.certSigningRequest

# Logs
*.log

# --- server ---
server/pb_data/
server/peard-server
server/server
*.test
coverage.out

# --- ios: local configuration ---
# Resolved build configuration (copy of ios/Config.example.xcconfig)
ios/Config.xcconfig

# --- ios: build output ---
ios/build/
DerivedData/
build/
*.ipa
*.dSYM
*.dSYM.zip
*.hmap
*.xcresult/

# --- ios: generated project ---
# ios/Peard.xcodeproj is generated from ios/project.yml by XcodeGen (make
# project). Committing it is what produced pbxproj merge conflicts and a file
# list to maintain by hand; project.yml is the source of truth instead.
ios/Peard.xcodeproj/

# --- ios: Xcode per-user state ---
# Rewritten on every open/build. Kept for any project not generated.
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside

# --- ios: SwiftPM ---
.build/
.swiftpm/

# --- fastlane ---
# Generated docs and per-run reports; the Fastfile and Appfile are committed.
fastlane/README.md
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/
# App Store Connect API key, if one is placed here.
fastlane/*.json
!fastlane/Appfile
vendor/bundle/
.bundle/

# --- profiling artefacts ---
*.memgraph
*.trace

# --- agent / editor local state ---
.kiro/specs/**/.config.kiro
