          }
        }
      }
    },
    "Finding friends is opt-in, and matches on one-way hashes computed on your device. Being findable by other people is a separate switch, off by default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Freunde finden ist optional und basiert auf Einweg-Hashes, die auf Ihrem Gerät berechnet werden. Von anderen Personen gefunden zu werden, ist ein separater Schalter, der standardmäßig deaktiviert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Encontrar amigos es opcional y se basa en hashes unidireccionales calculados en tu dispositivo. Ser localizable por otras personas es un interruptor separado, desactivado por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La recherche d'amis est facultative et se base sur des hachages unidirectionnels calculés sur votre appareil. Être trouvable par d'autres personnes est un interrupteur séparé, désactivé par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trovare amici è facoltativo e si basa su hash unidirezionali calcolati sul tuo dispositivo. Essere trovabile da altre persone è un'opzione separata, disattivata per impostazione predefinita."
          }
        }
      }
    },
