// Pear'd build configuration shared by both configurations (committed).
//
// The server URL is NOT here: it differs per configuration and lives in
// Config.debug.xcconfig (a local server) and Config.release.xcconfig (the
// production host, https://peard.kroper.uk). project.yml points each
// configuration at its own file, and both include this one.
//
// To change anything for your own machine, copy this file and edit the copy:
//
//     cp ios/Config.example.xcconfig ios/Config.xcconfig
//
// Config.xcconfig is git-ignored, so resolved values never reach source
// control, and a fresh clone still builds with the defaults below. Each
// configuration decides where that copy sits in its include order: Debug reads
// it last so it wins outright, while Release pins the production server above
// it and takes Release-only overrides from Config.release.local.xcconfig.
//
// The server URL is split into scheme and host because xcconfig treats "//" as
// the start of a comment, which would truncate a full URL. Info.plist rejoins
// them as $(PEARD_SERVER_SCHEME)://$(PEARD_SERVER_HOST).

// Google iOS OAuth client id (https://console.cloud.google.com/apis/credentials).
// The PocketBase users collection's Google provider must use the same client id.
// Leaving it empty disables Sign in with Google with an explanatory message.
PEARD_GOOGLE_IOS_CLIENT_ID =

// Debug only: credentials used by the AAAAAA fake-pair shortcut, which needs
// superuser rights to create pairs and members. Never read in Release builds.
PEARD_DEBUG_SUPERUSER_IDENTITY = admin@peard.app
PEARD_DEBUG_SUPERUSER_PASSWORD = Password123!

// Uncomment in your own Config.xcconfig to point a Debug build at another
// server — your LAN address for a physical device, for instance.
//
// PEARD_SERVER_SCHEME = http
// PEARD_SERVER_HOST = 192.168.1.42:8090
