#!/bin/bash
# Prints the UDID of the iPhone simulator to build, test and run on.
#
#   scripts/pick-simulator                  first available iPhone, newest iOS
#   scripts/pick-simulator "iPhone 17 Pro"  that model, on the newest iOS that has it
#
# A UDID rather than a name because `xcodebuild -destination name=X` with no OS
# only looks on the newest runtime: "iPhone 17 Pro" on a machine whose newest
# iOS only ships iPhone 18s matches nothing, and the error blames My Mac. CI and
# the Makefile both use this, so neither hard-codes a model that comes and goes
# with Xcode.
set -euo pipefail

xcrun simctl list devices available --json | python3 -c '
import json, sys
wanted = sys.argv[1] if len(sys.argv) > 1 else ""
devices = json.load(sys.stdin)["devices"]

def version(runtime):
    tail = runtime.rsplit(".", 1)[-1]            # e.g. iOS-27-0
    return tuple(int(p) for p in tail.split("-")[1:] if p.isdigit())

for runtime in sorted((r for r in devices if ".iOS-" in r), key=version, reverse=True):
    for device in devices[runtime]:
        if not device.get("isAvailable"):
            continue
        if device["name"] == wanted or (not wanted and device["name"].startswith("iPhone")):
            print(device["udid"])
            raise SystemExit
sys.exit("no available simulator matching " + (repr(wanted) if wanted else "an iPhone"))
' "$@"
