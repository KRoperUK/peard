    "Settings has a full export of your own data, and deleting your account from there erases it — no email to us, no waiting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "In den Einstellungen gibt es einen vollständigen Export deiner eigenen Daten, und das Löschen deines Kontos dort löscht sie – keine E-Mail an uns, kein Warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajustes tiene una exportación completa de tus propios datos, y eliminar tu cuenta desde allí la borra — sin enviarnos un correo electrónico, sin esperas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les réglages contiennent une exportation complète de vos propres données, et la suppression de votre compte à partir de là l'efface — pas d'e-mail à nous, pas d'attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le impostazioni contengono un'esportazione completa dei tuoi dati e l'eliminazione del tuo account da lì lo cancella — nessuna email a noi, nessuna attesa."
          }
        }
      }
    },
