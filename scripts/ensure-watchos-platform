#!/bin/bash
# Makes sure the selected Xcode can build for watchOS, downloading the platform
# if it is missing.
#
# For CI. The iPhone app embeds the watch app (issue #8), so every build of it
# builds for watchOS too, and since Xcode 26 the platform is a separate
# download that a runner image may not carry. `xcodebuild -showsdks` is no
# guide: it lists a watchOS SDK even when the platform is not installed and
# every build fails with "watchOS … is not installed". A watchOS simulator
# runtime is present exactly when the platform is, so that is what is checked.
# Run after scripts/select-newest-xcode, so the check is against the Xcode that
# will build.
set -euo pipefail

if xcrun simctl list runtimes | grep -q 'watchOS'; then
    echo "watchOS platform present"
    exit 0
fi

echo "watchOS platform missing; downloading it"
xcodebuild -downloadPlatform watchOS
