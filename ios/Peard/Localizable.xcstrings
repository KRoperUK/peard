    "Send it on its own, or pick what it's of — a moment with a photo still counts towards your tallies." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sende es allein, oder wähle, worum es geht – ein Moment mit einem Foto zählt trotzdem zu deinen Zählungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Envíalo solo, o elige de qué se trata — un momento con una foto fija cuenta para tus recuentos."
