# Point the app at your running Pear'd server.
# Use your LAN IP for a physical device (e.g. http://192.168.1.42:8090).
EXPO_PUBLIC_PB_URL=http://127.0.0.1:8090

# Google iOS OAuth client id (create one at https://console.cloud.google.com/apis/credentials).
# The PocketBase users collection's Google provider must use the same client id.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
