# Pear'd lanes.
#
#     bundle exec fastlane test          # PeardCore + app-target tests
#     bundle exec fastlane build         # Debug simulator build
#     bundle exec fastlane release_build # Release build, no signing needed
#     bundle exec fastlane archive       # signed .ipa for distribution
#     bundle exec fastlane beta          # archive + upload to TestFlight
#     bundle exec fastlane promote_external [build_number:123]
#                                        # send a TestFlight build to external testers
#
# ios/Peard.xcodeproj is generated by XcodeGen and is not committed, so every lane
# that touches Xcode regenerates it first. That is also why `generate` is a lane
# rather than a comment in the README: forgetting it is the one way these lanes
# fail confusingly.

require "shellwords"

default_platform(:ios)

PROJECT     = "ios/Peard.xcodeproj"
SCHEME      = "Peard"
SPEC        = "project.yml"
DERIVED     = "ios/build"
# A simulator by name only matches on the newest runtime, so a hard-coded model
# breaks whenever Xcode moves on. scripts/pick-simulator resolves a UDID, the
# same way the Makefile and CI do; PEARD_SIMULATOR still names a model.
def simulator_destination
  script = File.expand_path("../scripts/pick-simulator", __dir__)
  model = ENV["PEARD_SIMULATOR"].to_s
  udid = `#{script.shellescape} #{model.empty? ? "" : model.shellescape}`.strip
  UI.user_error!("No iPhone simulator available — see scripts/pick-simulator") if udid.empty?
  "platform=iOS Simulator,id=#{udid}"
end
OUTPUT_DIR  = "fastlane/build"

# The App Store Connect app record's numeric id (not the bundle id). Passing it
# to upload_to_testflight skips the bundle-id lookup, which needs an API key
# permitted to list every app on the account — narrower keys can upload to a
# known app but cannot enumerate, and the failure reads as "app not found"
# rather than as a permissions problem.
APP_STORE_APP_ID = ENV.fetch("PEARD_APP_STORE_APP_ID", "6795739297")

platform :ios do
  desc "Regenerate ios/Peard.xcodeproj from ios/project.yml"
  lane :generate do
    Dir.chdir("../ios") do
      sh("xcodegen", "generate", "--spec", SPEC)
    end
  end

  desc "PeardCore unit tests (no simulator)"
  lane :test_core do
    Dir.chdir("../ios/PeardCore") do
      sh("swift", "test")
    end
  end

  desc "App-target tests on a simulator"
  lane :test_app do
    generate
    run_tests(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      destination: simulator_destination,
      derived_data_path: DERIVED,
      # The scheme's own test action already lists PeardTests; naming it here as
      # well would fail on a fresh clone if the scheme regenerates differently.
      result_bundle: true,
      output_directory: "fastlane/test_output"
    )
  end

  desc "Go server build, vet and tests"
  lane :test_server do
    Dir.chdir("../server") do
      sh("go", "build", "./...")
      sh("go", "vet", "./...")
      sh("go", "test", "./...")
    end
  end

  desc "Everything: PeardCore, app target and server"
  lane :test do
    test_core
    test_server
    test_app
  end

  desc "Debug simulator build of the app and widget"
  lane :build do
    generate
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Debug",
      derived_data_path: DERIVED,
      destination: "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_archive: true,
      # The simulator signs ad hoc. Code signing stays ON: turning it off drops
      # the entitlements, which takes the Keychain and the App Group with it — an
      # app that cannot sign in.
      skip_codesigning: false
    )
  end

  desc "Release build for the simulator, to catch anything Debug-only"
  lane :release_build do
    generate
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      derived_data_path: DERIVED,
      destination: "generic/platform=iOS Simulator",
      skip_package_ipa: true,
      skip_archive: true
    )
  end

  desc "Signed archive for distribution. Needs a real signing identity."
  lane :archive do
    require_distribution_credentials!
    generate
    number = build_number
    UI.message("Build number #{number}")
    # Xcode's export runs /usr/bin/rsync and starts the receiving side by name,
    # so a Homebrew rsync earlier on PATH gets it — and it rejects Xcode's -E
    # ("--extended-attributes: unknown option"), failing the export with nothing
    # but "Copy failed". /usr/bin first, for this lane only.
    original_path = ENV["PATH"]
    ENV["PATH"] = "/usr/bin:#{original_path}"
    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      derived_data_path: DERIVED,
      output_directory: OUTPUT_DIR,
      output_name: "Peard.ipa",
      export_method: "app-store",
      # Leave the number alone. Xcode can renumber on export to one past what
      # App Store Connect last saw, which is one way to ship a build number
      # nobody chose (issue #7). The number is set above, and checked below.
      export_options: { manageAppVersionAndBuildNumber: false },
      # Automatic signing, matching the project: there is no match/sigh setup, so
      # Xcode resolves the profile from the team on the machine or — on a CI
      # runner with no Apple ID signed in — from the App Store Connect API key,
      # which has to be handed to xcodebuild itself for cloud-managed signing.
      xcargs: ["-allowProvisioningUpdates", *xcodebuild_auth_args, "CURRENT_PROJECT_VERSION=#{number.shellescape}"].join(" ")
    )
    ENV["PATH"] = original_path
    verify_build_number!("#{OUTPUT_DIR}/Peard.ipa", number)
  end

  desc "Archive and upload to TestFlight"
  lane :beta do
    archive
    upload_to_testflight(
      ipa: "#{OUTPUT_DIR}/Peard.ipa",
      app_identifier: "com.peard.app",
      apple_id: APP_STORE_APP_ID,
      skip_waiting_for_build_processing: true,
      # The same notes external testers get, so internal testers see what is
      # new too rather than a placeholder nobody updates.
      changelog: release_notes || what_to_test
    )
    # Handed to the external job, which promotes exactly this build.
    if (output = ENV["GITHUB_OUTPUT"])
      File.open(output, "a") do |file|
        file.puts("build_number=#{build_number}")
        file.puts("version=#{marketing_version}")
      end
    end
  end

  desc "SwiftLint, with the repository's .swiftlint.yml; errors fail, warnings do not"
  lane :lint do
    swiftlint(
      mode: :lint,
      config_file: File.expand_path("../.swiftlint.yml", __dir__),
      executable: `which swiftlint`.strip.then { |path| path.empty? ? nil : path },
      raise_if_swiftlint_error: true,
      quiet: true
    )
  end

  desc "Main's iOS pipeline: lint, unit tests, then archive and upload to internal TestFlight"
  # One lane so CI runs one thing, and so the order — nothing uploads unless the
  # lint and every unit test passed — lives in one place a person can also run.
  lane :ci_release do
    # Fixed once, here: `archive` stamps it into the IPA and `beta` reports it
    # to the external job, and two calls to Time.now would disagree.
    ENV["PEARD_BUILD_NUMBER"] = build_number
    lint
    test_core
    test_app
    beta
  end

  desc "Send a build already on TestFlight to the external testers' group"
  # No build here: the binary internal testers have been running is the one that
  # goes out, rather than a fresh archive of the same commit that nobody tried.
  # The first build of each version goes to Beta App Review before external
  # testers see it; later builds of that version usually go straight out.
  lane :promote_external do |options|
    require_distribution_credentials!
    group = ENV["PEARD_TESTFLIGHT_EXTERNAL_GROUP"]
    UI.user_error!("Set PEARD_TESTFLIGHT_EXTERNAL_GROUP to the external testers' group name") if group.to_s.empty?

    build = options[:build_number].to_s.strip
    build = ENV["PEARD_PROMOTE_BUILD"].to_s.strip if build.empty?
    version = options[:version].to_s.strip
    version = ENV["PEARD_PROMOTE_VERSION"].to_s.strip if version.empty?
    if build.empty?
      build = latest_testflight_build_number(app_identifier: "com.peard.app").to_s
      version = lane_context[SharedValues::LATEST_TESTFLIGHT_VERSION].to_s if version.empty?
    end
    version = marketing_version if version.empty?
    UI.message("Sending #{version} (#{build}) to #{group}")

    # A build uploaded minutes ago is not visible to the API straight away, and
    # an external group only takes one that has finished processing. pilot's
    # distribute looks it up once and gives up ("No build to distribute!" — or
    # this lane's own earlier lookup: "No TestFlight build … for app …"), so
    # wait here first, for this exact build.
    FastlaneCore::BuildWatcher.wait_for_build_processing_to_be_complete(
      app_id: APP_STORE_APP_ID,
      platform: "IOS",
      app_version: version,
      build_version: build,
      poll_interval: 30,
      timeout_duration: 45 * 60,
      return_spaceship_testflight_build: false
    )

    upload_to_testflight(
      app_identifier: "com.peard.app",
      apple_id: APP_STORE_APP_ID,
      # Named, because with distribute_only nothing else tells pilot which
      # platform the build is — and it asks, which on CI is a crash
      # ("Could not retrieve response as fastlane runs in non-interactive mode").
      app_platform: "ios",
      distribute_only: true,
      build_number: build,
      app_version: version,
      distribute_external: true,
      groups: [group],
      notify_external_testers: true,
      # External testers need "What to Test", and Beta App Review reads it.
      changelog: release_notes(version) || what_to_test
    )
  end

  # --- helpers ---

  # Distribution needs credentials that cannot be inferred. Failing here with a
  # readable message beats failing 8 minutes into an archive.
  #
  # Two spellings are accepted for the issuer and the key, because the .env this
  # reads in practice uses ..._API_KEY_ISSUER_ID and ..._API_KEY_BASE64 while the
  # names below are fastlane's own. The mismatch presented as "credentials are
  # not set" while sitting right next to a file that plainly had them.
  def require_distribution_credentials!
    key_id = ENV["APP_STORE_CONNECT_API_KEY_ID"]
    issuer = ENV["APP_STORE_CONNECT_API_ISSUER_ID"] || ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    base64 = ENV["APP_STORE_CONNECT_API_KEY_BASE64"]
    content = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"] || base64
    path = ENV["APP_STORE_CONNECT_API_KEY_PATH"]

    if key_id && issuer && (content || path)
      @auth_key = { id: key_id, issuer: issuer, path: key_file_for(content, path, base64_encoded: !base64.nil? || ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true") }
      app_store_connect_api_key(
        key_id: key_id,
        issuer_id: issuer,
        key_content: content,
        key_filepath: path,
        # A key supplied under the _BASE64 name says what it is in its name; the
        # _CONTENT one needs telling.
        is_key_content_base64: !base64.nil? || ENV["APP_STORE_CONNECT_API_KEY_IS_BASE64"] == "true",
        in_house: false
      )
      return
    end

    UI.user_error!(<<~MESSAGE)
      Distribution needs App Store Connect credentials, which are not set.

      Set these in the environment (or a .env fastlane picks up, which is
      git-ignored):

        APP_STORE_CONNECT_API_KEY_ID
        APP_STORE_CONNECT_API_ISSUER_ID       (or ..._API_KEY_ISSUER_ID)
        APP_STORE_CONNECT_API_KEY_CONTENT     (the .p8 contents)
          or APP_STORE_CONNECT_API_KEY_BASE64 (the same, base64-encoded)
          or APP_STORE_CONNECT_API_KEY_PATH   (path to the .p8)

      For a local build against your own Apple ID instead, run the archive from
      Xcode — the project uses automatic signing with team 72Q6R744M4.
    MESSAGE
  end

  # xcodebuild's own flags for signing with the API key. Empty without one, so a
  # local archive still signs with the Apple ID in Xcode.
  def xcodebuild_auth_args
    return [] unless @auth_key && @auth_key[:path]

    [
      "-authenticationKeyPath", @auth_key[:path].shellescape,
      "-authenticationKeyID", @auth_key[:id].shellescape,
      "-authenticationKeyIssuerID", @auth_key[:issuer].shellescape
    ]
  end

  # xcodebuild wants the key as a file. CI has it as a secret's contents, so it
  # is written into the git-ignored build folder for the length of the run.
  def key_file_for(content, path, base64_encoded:)
    return File.expand_path(path) if path && !path.empty?
    return nil if content.nil? || content.empty?

    require "base64"
    FileUtils.mkdir_p(File.expand_path("build", __dir__))
    file = File.expand_path("build/AuthKey.p8", __dir__)
    File.write(file, base64_encoded ? Base64.decode64(content) : content)
    File.chmod(0o600, file)
    file
  end

  # CI sets PEARD_BUILD_NUMBER to the upload time (Unix seconds) so every upload is unique;
  # locally the committed value (CURRENT_PROJECT_VERSION in ios/project.yml) is
  # used unchanged.
  #
  # Passed as an xcarg rather than through `increment_build_number`. That action
  # runs agvtool, which rewrites `$(CURRENT_PROJECT_VERSION)` in every target's
  # Info.plist to a literal — so an archive left four tracked plists dirty with
  # a build number in them, and the next developer to run `make app` got that
  # number baked in silently. An xcarg applies to all three targets at once
  # (they must agree, or App Store validation rejects the appexes), touches
  # nothing on disk, and leaves the plists saying what they mean.
  # Always explicit. PEARD_BUILD_NUMBER when given (CI sets it); otherwise the
  # current Unix time, which is the scheme every upload has used — so a local
  # archive and a CI one number the same way, and neither is ever "whatever the
  # cache had".
  def build_number
    number = ENV["PEARD_BUILD_NUMBER"].to_s.strip
    number = Time.now.to_i.to_s if number.empty?
    UI.user_error!("PEARD_BUILD_NUMBER must be digits, got #{number.inspect}") unless number.match?(/\A\d+\z/)
    number
  end

  # Fails the lane unless the app and every extension in the IPA carry the
  # number it was built with. App Store Connect rejects an upload whose
  # extensions disagree with the app, and a number that differs from the one
  # passed in is exactly what issue #7 could not explain after the fact.
  def verify_build_number!(ipa, expected)
    require "tmpdir"
    Dir.mktmpdir do |dir|
      sh("unzip", "-q", File.expand_path(ipa, ".."), "-d", dir, log: false)
      plists = Dir.glob(File.join(dir, "Payload", "*.app", "{,PlugIns/*.appex/}Info.plist"))
      UI.user_error!("No Info.plist found in #{ipa}") if plists.empty?
      wrong = plists.filter_map do |plist|
        found = `/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' #{plist.shellescape}`.strip
        "#{plist.sub(dir + "/", "")}: #{found}" unless found == expected
      end
      UI.user_error!("Build number is not #{expected} in:\n  #{wrong.join("\n  ")}") unless wrong.empty?
      UI.success("Build number #{expected} in the app and #{plists.count - 1} extension(s)")
    end
  end

  # The notes testers see when there are no release notes: the commit the
  # build came from, which on CI is the merge that triggered it.
  def what_to_test
    subject = `git log -1 --format=%s 2>/dev/null`.strip
    body = `git log -1 --format=%b 2>/dev/null`.strip
    text = [subject, body].reject(&:empty?).join("\n\n")
    text.empty? ? "Latest changes from main." : text[0, 4000]
  end

  # The app's MARKETING_VERSION, from the project spec that sets it.
  def marketing_version
    require "yaml"
    spec = YAML.load_file(File.expand_path("../ios/project.yml", __dir__))
    spec.dig("targets", "Peard", "settings", "base", "MARKETING_VERSION").to_s
  end

  # What testers are told is in a build, from release-please's changelog.
  #
  # First choice is the pending changelog: the body of the open release pull
  # request, which CI passes in as PEARD_RELEASE_NOTES. It lists everything
  # merged since the last release, which is what a build from main contains.
  # Without one (the build is of the release itself, or nothing releasable has
  # landed since), CHANGELOG.md's entry for this version. nil when neither.
  def release_notes(version = marketing_version)
    pending = ENV["PEARD_RELEASE_NOTES"].to_s
    return plain_release_notes(pending) unless pending.strip.empty?

    path = File.expand_path("../CHANGELOG.md", __dir__)
    return nil unless File.exist?(path)
    entry = changelog_entry(File.read(path), version)
    entry && plain_release_notes(entry)
  end

  # The section of CHANGELOG.md headed by `version`, or nil.
  def changelog_entry(changelog, version)
    sections = changelog.split(/^(?=## )/)
    sections.find { |section| section[/\A## \[?v?([\d.]+)/, 1] == version }
  end

  # TestFlight shows "What to Test" as plain text, so release-please's markdown
  # is flattened: the pull request's robot preamble and footer go, links keep
  # their text, commit hashes and pull request numbers go, and headings and
  # bullets lose their markup.
  # 4000 characters is App Store Connect's limit.
  def plain_release_notes(markdown)
    text = markdown.dup
    parts = text.split(/^---\s*$/)
    text = parts[1] if parts.length >= 3
    text = text
      .gsub(/\[([^\]]*)\]\([^)]*\)/, '\\1')
      .gsub(/\s*\([0-9a-f]{7,40}\)/, "")
      .gsub(/\s*\(#\d+\)/, "")
      .gsub(/^#+\s*/, "")
      .gsub(/\*\*([^*]+)\*\*/, '\\1')
      .gsub(/^\s*[*-]\s+/, "• ")
      .gsub(/\n{3,}/, "\n\n")
      .strip
    return nil if text.empty?
    text.length > 4000 ? "#{text[0, 3999]}…" : text
  end
end
