# --- Pear'd server configuration --------------------------------------------
#
# Values below are the production ones. For a server on your own machine use
#   PEARD_APP_URL=http://127.0.0.1:8090
#   PEARD_APNS_PRODUCTION=false
# and leave the APNs block unset if you are not testing push.

# Public URL of this server. Sets PocketBase's app URL, which is used to build
# the media URLs the widget feed returns; in dev the handler falls back to the
# request Host. No trailing slash.
PEARD_APP_URL=https://peard.kroper.uk

# Bundle id the Apple identity token audience must match (your iOS app). The
# server-to-server notification token carries the same audience.
PEARD_APPLE_AUDIENCE=com.peard.app

# What POST /api/peard/auth/apple/notifications does with Apple's account-delete
# event (the user permanently deleted their Apple Account).
#
# Unset/false — the default — ends every session and stops all contact: PB auth
# tokens are invalidated, widget tokens revoked, APNs devices removed and the
# Apple link dropped. The account row and its moments stay.
#
# true additionally deletes the user record. Understand the blast radius before
# turning it on: posts.author is CascadeDelete, so deleting the user also removes
# their moments from the shared timeline of every connection they were in, where
# the other members can see them. That is other people's view of their own
# history, which is why it is not the default.
#
# Either way the person cannot sign back in — their Apple Account is gone.
PEARD_APPLE_ERASE_ON_ACCOUNT_DELETE=false

# Sign in with Apple key, used to revoke a user's Apple authorisation when they
# delete their account (App Store guideline 5.1.1(v)). At sign-in the server
# exchanges the app's one-time authorization code for a refresh token, and on
# deletion sends it to Apple's /auth/revoke; both calls are authenticated with a
# client secret signed by this key.
#
# Create the key at https://developer.apple.com/account/resources/authkeys with
# "Sign in with Apple" enabled and the app's primary App ID selected.
# PEARD_APPLE_PRIVATE_KEY is base64 of the whole .p8, on one line:
#   base64 < AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
# (the PEM text verbatim is accepted too).
#
# All three unset: sign-in and deletion work as before, with nothing revoked.
# Apple being unreachable or refusing never blocks either; it is logged.
# Same team id as PEARD_APNS_TEAM_ID below.
PEARD_APPLE_TEAM_ID=
PEARD_APPLE_KEY_ID=
PEARD_APPLE_PRIVATE_KEY=

# --- Contact matching ---------------------------------------------------------
# Secret that keys the stored email_hash/phone_hash of every account: with it
# they are HMAC-SHA256(key, sha256), so a copy of the database cannot be
# reversed by brute force; without it they are plain SHA-256, which for phone
# numbers can be, and the server logs a warning at boot. The app is unaffected
# either way. Every boot re-keys every account from its stored email and phone,
# so setting, rotating or clearing this takes a restart and nothing else.
# Generate one with:  openssl rand -hex 32
PEARD_CONTACT_HASH_KEY=

# --- APNs (push notifications) ----------------------------------------------
# Leave unset to run with push disabled (server logs "[push] APNs not configured").
# Get the .p8 key from https://developer.apple.com/account/resources/authkeys —
# one team-scoped key covers both the sandbox and production hosts.
#
# The key can be given as a file path or as its content. Content wins when both
# are set, and it is the only option for the Docker stack: the .p8 is git-ignored,
# so a repo-based deploy cannot carry the file. Three encodings are accepted:
#
#   1. the PEM verbatim, with real newlines — fine in Komodo's Environment box,
#      but a compose `.env` file cannot hold a multi-line value;
#   2. the PEM with its newlines written as the two characters \n;
#   3. base64 of the whole PEM, which is one line and survives every layer:
#        base64 < AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
#
# Prefer 3 unless you are pasting into a UI that accepts newlines.
PEARD_APNS_KEY_CONTENT=
PEARD_APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
PEARD_APNS_KEY_ID=XXXXXXXXXX
PEARD_APNS_TEAM_ID=72Q6R744M4
PEARD_APNS_BUNDLE_ID=com.peard.app

# Which APNs host to send to, and it has to match how the app was built. A
# TestFlight or App Store build carries aps-environment=production (see
# ios/Peard/Peard-Release.entitlements), so its device tokens only resolve on
# api.push.apple.com — sending those to the sandbox host fails with
# BadDeviceToken and nothing in the app says why. Debug builds are the reverse.
PEARD_APNS_PRODUCTION=true

# --- PocketBase OAuth providers ----------------------------------------------
# Google OAuth is configured on the users auth collection (Dashboard >
# Collections > users > Options > OAuth2) with the client id/secret from
# https://console.cloud.google.com/apis/credentials — no env needed here.

# --- Docker / Komodo stack only ----------------------------------------------
# Read by docker-compose.yml rather than by the server itself. Ignored when you
# run the binary directly.

# Host port mapped to the container's 8090. Only used by the base (proxied)
# compose file; the TLS override replaces it with 80 and 443.
PEARD_HTTP_PORT=8090

# Name of the existing Docker network the cloudflared container is attached to,
# used only by docker-compose.cloudflared.yml. That file publishes no host port
# at all — the tunnel is the only ingress — so PEARD_HTTP_PORT above is ignored
# when it is in play. The network is declared external, so a wrong name fails at
# `up` rather than creating an empty network with no tunnel on it. Find it with:
#   docker inspect <cloudflared-container> \
#     --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{end}}'
PEARD_CLOUDFLARED_NETWORK=cloudflared_cloudflared

# Public hostname, used only by docker-compose.tls.yml. It is passed to `serve`
# as a positional argument, which is what PocketBase whitelists for Let's
# Encrypt — omitting it makes the whitelist the literal "0.0.0.0" and no
# certificate is ever issued. Must match PEARD_APP_URL's host.
PEARD_TLS_DOMAIN=peard.kroper.uk

# Timezone inside the container, for log timestamps and PocketBase's cron.
TZ=Etc/UTC

# Optional 32-character key that encrypts PocketBase's settings at rest — which
# is where the Google OAuth client secret is stored. The compose file always
# names it, which is harmless while it is unset: settings stay in plaintext.
#
# WARNING, verified rather than assumed: once settings have been saved with a
# key, starting without it (or with a different one) aborts the boot with
#   invalid settings db data or missing encryption key ""
# and the server never begins serving. There is no recovery path other than the
# key itself, so store it wherever you keep the APNs key — losing it means
# rebuilding pb_data from scratch. Leave unset unless you have somewhere safe.
PEARD_PB_ENCRYPTION_KEY=

# --- Rate limiting ---
#
# On by default; the rules live in internal/limits rather than in the PB
# dashboard, because the settings are rewritten on every boot.
#
# Set to `off` to disable the lot without a redeploy. Worth knowing about before
# you need it: the limits were sized by judgement rather than by a load test, so
# if legitimate traffic ever starts getting 429s, this is the way out.
PEARD_RATE_LIMITS=

# Which header carries the real client IP, when something sits in front of the
# server. Empty means "use the direct connection", which is right for a server
# reachable directly and wrong behind a proxy — there, every request arrives from
# the proxy, so the rate limits above would apply to all users collectively
# rather than to each of them.
#
# docker-compose.cloudflared.yml sets this to CF-Connecting-IP for you. Only set
# it where something reliably overwrites the header AND the origin cannot be
# reached around that something; otherwise anybody can pick their own rate-limit
# bucket by sending the header themselves.
PEARD_TRUSTED_PROXY_HEADER=

# --- Scheduled backups ---
#
# PocketBase's built-in backups, configured here rather than in the dashboard so
# that a rebuilt or restored server backs itself up from its first boot. Each
# backup is a zip of pb_data: the databases and uploaded media. Nothing is
# scheduled while PEARD_BACKUP_CRON is unset, and the dashboard's settings stand.
# See "Backups and restoring" in the README for the restore runbook.

# Cron expression, in the container's TZ (UTC by default), e.g. 0 3 * * * for
# daily at 03:00. At least daily: the server warns when the newest backup is
# more than two days old.
PEARD_BACKUP_CRON=
# How many scheduled backups to keep; older ones are deleted. Default 7.
PEARD_BACKUP_MAX_KEEP=

# S3-compatible target (Cloudflare R2, Backblaze B2, AWS S3, MinIO). Set the
# bucket and the rest become required. Without a bucket, backups stay in
# pb_data/backups — on the same disk as the data, which the server warns about.
#
# Cloudflare R2: endpoint https://<account id>.r2.cloudflarestorage.com, region
# auto. Backblaze B2: endpoint https://s3.<region>.backblazeb2.com and its region.
# FORCE_PATH_STYLE=true for MinIO and most self-hosted stores.
#
# Give the key access to this bucket only. It needs to list, read, write and
# delete — delete for retention — and nothing else.
PEARD_BACKUP_S3_ENDPOINT=
PEARD_BACKUP_S3_BUCKET=
PEARD_BACKUP_S3_REGION=
PEARD_BACKUP_S3_ACCESS_KEY=
PEARD_BACKUP_S3_SECRET=
PEARD_BACKUP_S3_FORCE_PATH_STYLE=
